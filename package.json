{
  "name": "imagesystem-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc -p tsconfig.worker.json",
    "start:web": "next start -H 0.0.0.0",
    "start:worker": "node dist/worker/index.js",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:platform-isolation": "node scripts/check-platform-isolation.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "backup:restore:local": "node scripts/backup-restore-local.mjs"
  },
  "dependencies": {
    "next": "16.4.1",
    "pg": "^8.16.3",
    "pg-boss": "12.37.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "railway": "3.16.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
